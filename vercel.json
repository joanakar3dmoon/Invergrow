{
  "version": 2,
  "routes": [
    {
      "src": "/api/generate",
      "dest": "/api/generate.js"
    },
    {
      "src": "/api/data",
      "dest": "/api/data.js"
    },
    {
      "src": "/api/chat",
      "dest": "/api/chat.js"
    },
    {
      "src": "/api/reinvest",
      "dest": "/api/reinvest.js"
    },
    {
      "src": "/api/income",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/withdraw",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/ai/generate",
      "dest": "/api/ai/generate.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/sw.js",
      "dest": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "src": "/icons/(.*)",
      "dest": "/icons/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}